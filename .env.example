# Copy to .env and fill in locally. .env is gitignored and must stay that way.
# Nothing in this file is a real credential.
#
# In deployed environments these come from the platform's secret store, not
# from a file. The migration runner reads standard libpq variables so it needs
# no configuration of its own.

# ── Database ────────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=registry
PGUSER=dev
PGPASSWORD=changeme

# Alternative to the above; takes precedence in migrate.sh if set.
# Require TLS everywhere except a local container.
# DATABASE_URL=postgresql://user:pass@host:5432/registry?sslmode=verify-full

# ── Frontend ────────────────────────────────────────────────────────────────
# local = browser localStorage, development only, ~5MB ceiling, no audit trail.
# api   = the server. Not implemented yet; it throws rather than pretending.
VITE_STORAGE_BACKEND=local

# Required when VITE_STORAGE_BACKEND=api.
# VITE_API_BASE=https://registry.internal.example/api
