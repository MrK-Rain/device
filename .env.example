# Copy to .env and fill in locally. .env is gitignored and must stay that way.
# Nothing in this file is a real credential.
#
# In deployed environments these come from the platform's secret store, not
# from a file.

# ── API (generated by deploy/preflight.mjs --write-template) ──────────────
# Do not hand-edit the values below this line -- edit deploy/config-spec.mjs
# and run `node deploy/preflight.mjs --write-template .env.example` (this
# section only; the Frontend section below is separate and hand-maintained).
# The migration runner reads the same PG*/DATABASE_URL variables, so there is
# one way to point at a database rather than two.

NODE_ENV=development

AUTH_MODE=oidc

PORT=8080

HOST=0.0.0.0

# 1.2/1.4 (rain + eng) — the real cluster and how its credential reaches this process
# REQUIRED
DATABASE_URL=

PGHOST=localhost

PGPORT=5432

PGDATABASE=registry

PGUSER=registry_app

# 1.4 (rain + eng) — prefer IAM/certificate auth over a password
# REQUIRED
PGPASSWORD=changeme

PG_POOL_MAX=10

PG_IDLE_TIMEOUT_MS=30000

PG_CONNECT_TIMEOUT_MS=5000

PG_STATEMENT_TIMEOUT_MS=15000

# 1.5 — must stay verify-full; 'require' encrypts but authenticates nothing
PGSSLMODE=verify-full

# 1.6 (rain) — from rain's IdP
# REQUIRED when AUTH_MODE != dev
OIDC_JWKS_URI=https://REPLACE-ME.example/.well-known/jwks.json

# 1.6 (rain)
# REQUIRED when AUTH_MODE != dev
OIDC_ISSUER=https://REPLACE-ME.example/issuer

# 1.6 (rain)
# REQUIRED when AUTH_MODE != dev
OIDC_AUDIENCE=REPLACE-ME-audience

OIDC_GROUPS_CLAIM=groups

OIDC_SUBJECT_CLAIM=preferred_username

OIDC_CLOCK_TOLERANCE_SEC=30

# 1.6 (rain) — the 4 directory group names inside must be real, checked individually below
AUTH_ROLE_MAP={"device-registry-managers":"manager","device-registry-warehouse":"warehouse","device-registry-technicians":"technician","device-registry-readonly":"readonly"}

RATE_LIMIT_MAX=300

RATE_LIMIT_WINDOW_MS=60000

TRUST_PROXY=false

# For local dev without a real IdP: set AUTH_MODE=dev above. It is refused
# outright if NODE_ENV=production also gets set (api/src/config.js), and
# preflight does not require the OIDC_*/AUTH_ROLE_MAP values in that mode.

# ── Frontend (hand-maintained; outside deploy/config-spec.mjs) ────────────
# local = browser localStorage, development only, ~5MB ceiling, no audit trail.
# api   = talks to the real API (web/src/api-client.js).
VITE_STORAGE_BACKEND=local

# Required when VITE_STORAGE_BACKEND=api.
# VITE_API_BASE=https://registry.internal.example/api

# Bearer token sent with every API request. There is no login flow in the
# frontend yet — real auth is OIDC against rain's IdP (DEPLOYMENT-READINESS
# 1.6), which is not configured. Until then this is a pre-issued token: in
# AUTH_MODE=dev on the API, one registered with registerDevToken(); in a real
# deployment, a token obtained out of band. Do not build a password form
# against this — the API only trusts rain's IdP for identity.
# VITE_API_TOKEN=tok-tech
